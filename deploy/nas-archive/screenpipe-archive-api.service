[Unit]
Description=Screenpipe Tailnet compatible API and archive search gateway
After=network-online.target screenpipe-archive-postgres.service docker.service
Requires=screenpipe-archive-postgres.service

[Service]
Type=simple
User=screenpipe-archive
Group=screenpipe-archive
EnvironmentFile=/opt/screenpipe-archive/.env
Environment="DATABASE_URL=postgresql:///screenpipe_archive?host=/run/screenpipe-archive&port=15432"
Environment=ARCHIVE_ROOT=/vol1/1000/jing/screenpipe-archive/jing-2
Environment=MACHINE_KEY=jing-2
Environment=TAILSCALE_IP=100.64.0.1
ExecStart=/opt/screenpipe-archive/.venv/bin/python /opt/screenpipe-archive/python/archive_api.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
