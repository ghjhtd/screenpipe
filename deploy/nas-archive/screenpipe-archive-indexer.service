[Unit]
Description=Screenpipe rebuildable PostgreSQL archive indexer
After=screenpipe-archive-postgres.service screenpipe-archive-maintenance.service
Requires=screenpipe-archive-postgres.service

[Service]
Type=simple
User=screenpipe-archive
Group=screenpipe-archive
Environment="DATABASE_URL=postgresql:///screenpipe_archive?host=/run/screenpipe-archive&port=15432"
Environment=ARCHIVE_ROOT=/vol1/1000/jing/screenpipe-archive/jing-2
Environment=SERVING_DB=/vol1/1000/jing/screenpipe-archive/jing-2/_service/screenpipe/db.sqlite
Environment=MACHINE_KEY=jing-2
Environment="MACHINE_NAME=Jing MacBook Pro"
ExecStart=/opt/screenpipe-archive/.venv/bin/python /opt/screenpipe-archive/python/indexer.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
