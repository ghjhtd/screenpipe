[Unit]
Description=Screenpipe isolated PostgreSQL archive index
After=local-fs.target

[Service]
Type=simple
User=screenpipe-archive
Group=screenpipe-archive
RuntimeDirectory=screenpipe-archive
RuntimeDirectoryMode=0750
ExecStart=/usr/lib/postgresql/15/bin/postgres -D /vol1/1000/jing/screenpipe-archive/jing-2/_service/postgres -p 15432 -k /run/screenpipe-archive -c listen_addresses=127.0.0.1 -c shared_buffers=128MB -c max_connections=30
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
